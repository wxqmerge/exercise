{
  "name": "exercise-server",
  "version": "0.1.0",
  "description": "Exercise App - Node.js/Express backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc && node ../scripts/flatten-server-dist.js",
