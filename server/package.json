    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.39",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
